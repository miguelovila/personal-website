# Host port exposed by docker compose.
SITE_PORT=8080

# Tag used for the locally built Docker image.
IMAGE_TAG=latest

# Feature flags are build-time values for Astro.
# Rebuild the image after changing them: docker compose up --build -d
FEATURE_FLAGS=all

# Optional individual overrides. Accepted values include true/false, 1/0,
# yes/no, on/off, enabled/disabled.
FEATURE_BLOG=false
FEATURE_PROJECTS=false
FEATURE_ABOUT=false
FEATURE_SEARCH=false
