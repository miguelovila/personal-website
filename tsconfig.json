{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", ".test-dist*", ".astro-test", ".test-content", "test-results"],
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
