---
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/main-layout.astro";
import Card from "@/components/card/card.astro";
import { transformProjectToCard, sortByDateDesc } from "@/utils";

const projects = await getCollection("projects");
const sortedProjects = [...projects].sort(sortByDateDesc);
const featuredProjects = sortedProjects.filter((p) => p.data.featured);

const allTechnologies = [
  ...new Set(projects.flatMap((p) => p.data.technologies || [])),
].sort();
---

<MainLayout title="Projects">
  <main class="space-y-12">
    {
      featuredProjects.length > 0 && (
        <section>
          <h1 class="text-3xl font-bold pb-4 mb-6 border-b">
            Featured Projects
          </h1>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {featuredProjects.map((project, index) => (
              <Card
                {...transformProjectToCard(project)}
                loading={index < 3 ? "eager" : "lazy"}
              />
            ))}
          </div>
        </section>
      )
    }

    <section>
      <h2 class="text-3xl font-bold pb-4 mb-6 border-b">
        {featuredProjects.length > 0 ? "All Projects" : "My Projects"}
      </h2>

      <div class="flex flex-wrap gap-2 mb-6" id="tech-filters">
        <button
          class="filter-btn active px-3 py-1 bg-primary text-primary-foreground rounded-full text-sm transition-colors"
          data-tech="all"
        >
          All
        </button>
        {
          allTechnologies.map((tech) => (
            <button
              class="filter-btn px-3 py-1 bg-muted text-muted-foreground hover:bg-primary hover:text-primary-foreground rounded-full text-sm transition-colors"
              data-tech={tech}
            >
              {tech}
            </button>
          ))
        }
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
        {
          sortedProjects.map((project, index) => {
            const effectiveIndex =
              featuredProjects.length > 0
                ? featuredProjects.length + index
                : index;
            return (
              <div
                class="project-card"
                data-technologies={JSON.stringify(
                  project.data.technologies || []
                )}
              >
                <Card
                  {...transformProjectToCard(project)}
                  loading={effectiveIndex < 6 ? "eager" : "lazy"}
                />
              </div>
            );
          })
        }
      </div>
    </section>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const filterButtons = document.querySelectorAll(".filter-btn");
      const projectCards = document.querySelectorAll(".project-card");

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const selectedTech = button.getAttribute("data-tech");

          filterButtons.forEach((btn) => {
            btn.classList.remove(
              "active",
              "bg-primary",
              "text-primary-foreground"
            );
            btn.classList.add("bg-muted", "text-muted-foreground");
          });
          button.classList.add("active", "bg-primary", "text-primary-foreground");
          button.classList.remove("bg-muted", "text-muted-foreground");

          projectCards.forEach((card) => {
            const htmlCard = card as HTMLElement;
            const technologiesAttr =
              htmlCard.getAttribute("data-technologies") || "[]";
            const cardTechnologies = JSON.parse(technologiesAttr);
            const shouldShow =
              selectedTech === "all" ||
              cardTechnologies.includes(selectedTech);

            htmlCard.style.display = shouldShow ? "block" : "none";
          });
        });
      });
    });
  </script>
</MainLayout>
