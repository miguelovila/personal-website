---
import { getCollection } from 'astro:content';
import Layout from '@layouts/main-layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <article class="space-y-8">
      <header class="space-y-4">
        <h1 class="text-4xl font-bold text-foreground">{post.data.title}</h1>
        <p class="text-xl text-muted-foreground">{post.data.description}</p>

        <div class="flex flex-wrap gap-4 items-center text-sm">
          <time class="text-muted-foreground">
            Published: {post.data.publishedDate.toLocaleDateString()}
          </time>
        </div>
      </header>

      <div class="max-w-none">
        <Content />
      </div>
    </article>
  </div>
</Layout>