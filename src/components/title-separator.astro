<div class="title-separator w-full overflow-hidden" id="title-separator">
</div>

<script>
  function createGrid() {
    const container = document.getElementById('title-separator');
    if (!container) return;

    const containerWidth = container.offsetWidth;
    const containerHeight = Math.max(160, Math.floor(containerWidth * 0.1));
    const squareSize = 32; // 2rem = 32px
    const squaresPerRow = Math.ceil(containerWidth / squareSize);
    const rows = Math.ceil(containerHeight / squareSize);

    container.innerHTML = '';
    container.style.display = 'flex';
    container.style.flexDirection = 'column';
    container.style.width = '100%';
    container.style.height = `${rows * squareSize}px`;

    for (let row = 0; row < rows; row++) {
      const rowDiv = document.createElement('div');
      rowDiv.style.display = 'flex';
      rowDiv.style.height = `${squareSize}px`;

      if (row > 0) {
        rowDiv.style.marginTop = '-1px';
      }

      for (let col = 0; col < squaresPerRow; col++) {
        const square = document.createElement('div');
        square.style.flex = '1';
        square.style.height = `${squareSize}px`;
        square.style.border = '1px solid var(--border)';
        square.style.boxSizing = 'border-box';
        square.style.minWidth = '0';

        const isFirstCol = col === 0;
        const isLastCol = col === squaresPerRow - 1;

        // Remove unnecessary borders
        if (isFirstCol) {
          square.style.borderLeftWidth = '0';
        }
        if (isLastCol) {
          square.style.borderRightWidth = '0';
        }

        if (col > 0) {
          square.style.marginLeft = '-1px';
        }

        rowDiv.appendChild(square);
      }

      container.appendChild(rowDiv);
    }
  }

  // Create initial grid
  createGrid();

  // Recreate grid on window resize
  let resizeTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(createGrid, 1);
  });
</script>
