---
import { copy } from "@/lib/i18n";
import { localePath, type Language } from "@/lib/publishing";
import { getFeatureFlags } from "@/lib/feature-flags";
import SearchPanel from "../search/search-panel";
interface Props {
  language: Language;
  hasContent: boolean;
}
const { language, hasContent } = Astro.props;
const t = copy[language];
const flags = getFeatureFlags();
const contentKinds = { posts: flags.blog, projects: flags.projects };
const description =
  flags.blog && flags.projects
    ? t.searchDescription
    : flags.blog
      ? t.searchDescriptionPosts
      : t.searchDescriptionProjects;
const noScriptMessage =
  flags.blog && flags.projects
    ? t.searchNoJS
    : flags.blog
      ? t.searchNoJSPosts
      : t.searchNoJSProjects;
---

<div class="site-frame archive" data-search-page>
  <header class="page-header"><h1>{t.search}</h1><p class="lead">{description}</p></header>
  <div data-enhanced-search class="max-w-3xl">
    <SearchPanel client:load {language} {hasContent} {contentKinds} syncURL />
  </div>
  <noscript>
    <style is:inline>
      [data-enhanced-search] {
        display: none !important;
      }
    </style>
    <p>{noScriptMessage}</p>
    <div class="flex flex-wrap gap-6">
      {
        flags.blog && (
          <a class="text-link" href={localePath(language, "posts")}>
            {t.allPosts}
          </a>
        )
      }
      {
        flags.projects && (
          <a class="text-link" href={localePath(language, "projects")}>
            {t.allProjects}
          </a>
        )
      }
    </div>
  </noscript>
</div>
