---
import { copy } from "@/lib/i18n";
import type { Language } from "@/lib/publishing";
import { getFeatureFlags } from "@/lib/feature-flags";
import { entryPath, getSiteContent } from "@/lib/content";
import { entrySlug } from "@/lib/publishing";
import EnglishStory from "@/components/about/story-en.astro";
import PortugueseStory from "@/components/about/story-pt.astro";
interface Props {
  language: Language;
}
const { language } = Astro.props;
const t = copy[language];
const flags = getFeatureFlags();
const { projects } = await getSiteContent({ posts: false, projects: flags.projects });
const projectLinks = Object.fromEntries(
  projects
    .filter((project) => project.data.language === language)
    .map((project) => [entrySlug(project.id), entryPath(project)])
);
const Story = language === "pt" ? PortugueseStory : EnglishStory;
---

<div class="site-frame">
  <header class="page-header">
    <p class="eyebrow">{t.aboutLabel}</p><h1>{t.aboutTitle}</h1><p class="lead">{t.aboutLead}</p>
  </header>
  <div class="about-grid">
    <div class="prose">
      <Story {projectLinks} />
      <div class="about-contact">
        <h2 id="contact">{t.contact}</h2>
        <p>{t.contactBody}</p>
        <p><a href="mailto:me@miguelovila.pt">me@miguelovila.pt</a></p>
      </div>
    </div>
    <aside class="about-aside" aria-label={t.elsewhere}>
      <div class="about-profile">
        <img
          src="/images/profile-picture-pixelated.png"
          alt={language === "pt" ? "Miguel Vila em pixel art" : "Miguel Vila in pixel art"}
          width="160"
          height="160"
        />
        <div><p class="meta">Miguel Vila</p><p class="about-location">Estarreja, Portugal</p></div>
      </div>
      <nav aria-label={t.contact}>
        <a href="https://github.com/miguelovila">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/miguelovila">LinkedIn ↗</a>
        <a href="mailto:me@miguelovila.pt">me@miguelovila.pt ↗</a>
      </nav>
      <section class="about-education" aria-labelledby="education">
        <h2 id="education">{t.aboutEducation}</h2>
        <p class="about-university">{t.aboutUniversity}</p>
        <dl>
          <dt>{t.aboutMaster}</dt><dd>{t.aboutMasterDates}</dd>
          <dt>{t.aboutBachelor}</dt><dd>2021–2024</dd>
        </dl>
      </section>
    </aside>
  </div>
</div>
