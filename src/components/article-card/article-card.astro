---
import Slideshow from "@components/article-card/card-slideshow.astro";
import { Image } from "astro:assets";

interface CardProps {
  title: string;
  description: string;
  image: string | string[];
  read_duration?: number;
  link: string;
  loading?: "eager" | "lazy";
}

const {
  title,
  description,
  image,
  read_duration,
  link,
  loading = "lazy",
} = Astro.props as CardProps;
---

<a href={link}>
  <article
    class="bg-card rounded-md relative shadow-sm overflow-clip hover:scale-102 transition-all after:bg-primary after:absolute after:h-1 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-300 break-inside-avoid group"
  >
    <div class="mb-2 h-1/2">
      {
        Array.isArray(image) ? (
          <Slideshow images={image} alt={title} loading={loading} />
        ) : (
          <Image
            src={image}
            alt={title}
            class="border-b h-[200px] w-full object-cover"
            width={400}
            height={200}
            loading={loading}
          />
        )
      }
    </div>
    <div class="pl-4 pr-4 flex flex-col gap-1">
      <h3 class="text-xl font-bold line-clamp-2">{title}</h3>
      <p class="text-md line-clamp-3">
        {description}
      </p>
      <footer class="flex justify-between mt-2 pt-2 pb-2">
        {
          read_duration && (
            <p class="text-sm text-muted-foreground">
              {read_duration} min read
            </p>
          )
        }
        <p class="text-sm text-primary">Learn More</p>
      </footer>
    </div>
  </article>
</a>
