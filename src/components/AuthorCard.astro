---
import { Image } from "astro:assets";

interface Props {
  name: string;
  email?: string;
  image: string;
  role: string;
}

const { name, email, image, role } = Astro.props;
---

<div
  class="flex flex-col items-center bg-card rounded-md p-4 shadow-sm border border-border hover:shadow-md transition-all"
>
  <div class="w-20 h-20 rounded-full overflow-hidden mb-3 border-2 border-primary">
    <Image
      src={image}
      alt={name}
      class="w-full h-full object-cover"
      width={80}
      height={80}
      loading="lazy"
    />
  </div>
  <h3 class="text-lg font-semibold text-foreground mb-1 mt-0">{name}</h3>
  <p class="text-sm text-muted-foreground mb-2">{role}</p>
  {
    email && (
      <a
        href={`mailto:${email}`}
        class="text-xs text-primary hover:underline transition-all"
      >
        {email}
      </a>
    )
  }
</div>
