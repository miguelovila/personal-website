---
import { copy } from "@/lib/i18n";
import { localePath, type Language } from "@/lib/publishing";
import type { Alternate } from "@/lib/content";
import LanguageLinks from "../navigation/language-links.astro";
import { getFeatureFlags } from "@/lib/feature-flags";
interface Props {
  language: Language;
  alternates: Alternate[];
  fallbackPath?: string;
}
const { language, alternates, fallbackPath } = Astro.props;
const t = copy[language];
const flags = getFeatureFlags();
const hasSiteLinks = flags.projects || flags.blog || flags.about;
const year = new Date().getFullYear();
---

<footer class="site-footer footer-redesign" data-pagefind-ignore>
  <div class="site-frame footer-redesign__shell">
    <a
      class="footer-redesign__brand"
      href={localePath(language)}
      aria-label={`Miguel Vila — ${t.home}`}
    >
      <img src="/images/profile-picture-pixelated.png" width="40" height="40" alt="" />
      <span>Miguel Vila<span class="wordmark-cursor" aria-hidden="true">_</span></span>
    </a>
    <div class="footer-redesign__links">
      {
        hasSiteLinks && (
          <nav
            class="footer-redesign__group"
            aria-label={language === "pt" ? "Ligações do rodapé" : "Footer links"}
          >
            <span>Site</span>
            <div>
              {flags.projects && <a href={localePath(language, "projects")}>{t.projects}</a>}
              {flags.blog && <a href={localePath(language, "posts")}>{t.blog}</a>}
              {flags.about && <a href={localePath(language, "about")}>{t.about}</a>}
              {flags.blog && (
                <a href={localePath(language, "rss.xml")} data-astro-reload>
                  {t.rssShort} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </nav>
        )
      }
      <nav class="footer-redesign__group" aria-label={t.elsewhere}>
        <span>{t.elsewhere}</span>
        <div>
          <a href="https://github.com/miguelovila">GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/in/miguelovila"
            >LinkedIn <span aria-hidden="true">↗</span></a
          >
          <a href="mailto:contact@miguelovila.pt">Email <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </div>
    <div class="footer-redesign__meta">
      <small>© {year} Miguel Vila</small>
      <LanguageLinks {language} {alternates} {fallbackPath} />
    </div>
  </div>
</footer>

<style>
  .site-footer.footer-redesign {
    margin-top: clamp(3.5rem, 9vw, 7rem);
    border-top: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper) 94%, var(--accent-soft));
  }
  .footer-redesign__shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.75rem, 5vw, 4.5rem);
    align-items: start;
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 1.25rem;
  }
  .footer-redesign__brand {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2vw, 1.12rem);
    line-height: 1.1;
  }
  .footer-redesign__brand img {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    transition: transform var(--motion-fast) var(--motion-ease);
  }
  .footer-redesign__brand:hover img {
    transform: translateY(-2px);
  }
  .footer-redesign__brand > span {
    overflow-wrap: anywhere;
  }
  .footer-redesign__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(8rem, max-content));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .footer-redesign__group {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }
  .footer-redesign__group > span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .footer-redesign__group > div {
    display: grid;
    gap: 0.15rem;
  }
  .footer-redesign__group a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.28rem;
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.25;
  }
  .footer-redesign__group a:hover {
    color: var(--accent);
  }
  .footer-redesign__meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    color: var(--muted);
  }
  .footer-redesign__meta small {
    font-size: 0.82rem;
  }

  @media (max-width: 760px) {
    .footer-redesign__shell {
      grid-template-columns: 1fr;
    }
    .footer-redesign__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .footer-redesign__links {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .footer-redesign__group a {
      min-height: 2.5rem;
    }
    .footer-redesign__meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
