---
import { Image } from "astro:assets";
import type { CardProps } from "@/types";

type Props = CardProps;

const { title, description, image, readDuration, link, loading = "lazy" } = Astro.props;
---

<a href={link}>
  <article
    class="flex flex-col flex-1 bg-card h-full rounded-md relative shadow-sm overflow-clip hover:scale-102 transition-all after:bg-primary after:absolute after:h-1 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-300 break-inside-avoid group"
  >
    <div class="h-[200px]">
      {
        Array.isArray(image) ? (
          <div
            class="slideshow-container relative w-full h-[200px] overflow-hidden border-b"
            data-images={JSON.stringify(image)}
          >
            {image.map((src, i) => (
              <Image
                src={src}
                alt={title}
                class={`slideshow-image absolute top-0 left-0 w-full h-full object-cover transition-opacity duration-500 ${
                  i === 0 ? "opacity-100" : "opacity-0"
                }`}
                width={400}
                height={200}
                loading={i === 0 ? loading : "lazy"}
                data-index={i}
              />
            ))}

            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-2">
              {image.map((_, i) => (
                <button
                  class={`slideshow-dot w-2 h-2 rounded-full shadow transition-colors ${
                    i === 0 ? "bg-primary" : "bg-muted-foreground"
                  }`}
                  data-index={i}
                  aria-label={`Go to image ${i + 1}`}
                />
              ))}
            </div>

            <div class="absolute left-1/2 -translate-x-1/2 flex gap-2 justify-between w-[150%] px-4 top-1/2 -translate-y-1/2 group-hover:w-full transition-all">
              <button
                class="slideshow-button rounded-full w-7 h-7 bg-border cursor-pointer hover:scale-105 transition-transform"
                aria-label={`Go to previous image`}
                data-action="prev"
              >
                &#10094;
              </button>
              <button
                class="slideshow-button rounded-full w-7 h-7 bg-border cursor-pointer hover:scale-105 transition-transform"
                aria-label={`Go to next image`}
                data-action="next"
              >
                &#10095;
              </button>
            </div>
          </div>
        ) : (
          <Image
            src={image}
            alt={title}
            class="border-b h-[200px] w-full object-cover"
            width={400}
            height={200}
            loading={loading}
          />
        )
      }
    </div>
    <div class="flex-1 flex flex-col justify-between">
      <div class="pl-4 pr-4 flex flex-col gap-1">
        <h3 class="text-xl font-bold line-clamp-2 min-h-[2lh]">{title}</h3>
        <p class="text-md line-clamp-3">{description}</p>
      </div>
      <footer class="flex justify-between pl-4 pr-4">
        {readDuration && <p class="text-sm text-muted-foreground">{readDuration} min read</p>}
        <p class="text-sm text-primary">Learn More</p>
      </footer>
    </div>
  </article>
</a>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const slideshows = document.querySelectorAll(".slideshow-container");

    slideshows.forEach((slideshow) => {
      const images = slideshow.querySelectorAll(".slideshow-image");
      const dots = slideshow.querySelectorAll(".slideshow-dot");
      const prevButton = slideshow.querySelector('button[data-action="prev"]');
      const nextButton = slideshow.querySelector('button[data-action="next"]');
      let currentIndex = 0;
      let interval: ReturnType<typeof setInterval> | null = null;
      let isHovered = false;

      const showImage = (index: number) => {
        images.forEach((img, i) => {
          img.classList.toggle("opacity-100", i === index);
          img.classList.toggle("opacity-0", i !== index);
        });

        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.remove("bg-muted-foreground");
            dot.classList.add("bg-primary");
          } else {
            dot.classList.remove("bg-primary");
            dot.classList.add("bg-muted-foreground");
          }
        });

        currentIndex = index;
      };

      const startSlideshow = () => {
        if (interval) return;
        interval = setInterval(() => {
          currentIndex = (currentIndex + 1) % images.length;
          showImage(currentIndex);
        }, 2000);
      };

      const stopSlideshow = () => {
        if (interval) {
          clearInterval(interval);
          interval = null;
        }
      };

      const card = slideshow.closest("article");
      if (card) {
        card.addEventListener("mouseenter", () => {
          isHovered = true;
          stopSlideshow();
        });

        card.addEventListener("mouseleave", () => {
          isHovered = false;
          startSlideshow();
        });
      }

      dots.forEach((dot, index) => {
        dot.addEventListener("click", (e) => {
          e.preventDefault();
          showImage(index);
          if (isHovered) {
            startSlideshow();
            stopSlideshow();
          }
        });
      });

      prevButton?.addEventListener("click", (e) => {
        e.preventDefault();
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        showImage(currentIndex);
        startSlideshow();
        stopSlideshow();
      });

      nextButton?.addEventListener("click", (e) => {
        e.preventDefault();
        currentIndex = (currentIndex + 1) % images.length;
        showImage(currentIndex);
        startSlideshow();
        stopSlideshow();
      });

      startSlideshow();
    });
  });
</script>
